{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The public demo: hosted Dovre's pages over made-up data. It reads no bindings besides the
  // icons and fonts: no secrets, no database, no Access, no bridge.
  "name": "dovre-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // The zone route too: a wildcard route on the zone (*.dovre.dev/*) would otherwise take this host,
  // custom domain or not.
  "routes": [{ "pattern": "demo.dovre.dev", "custom_domain": true }, { "pattern": "demo.dovre.dev/*", "zone_name": "dovre.dev" }],
  "observability": { "enabled": true },
  // Anonymous counts of demo opens, pages and Bino questions, kept by dovre-control (workers/control/visits.ts).
  "services": [{ "binding": "VISITS", "service": "dovre-control", "entrypoint": "Visits" }],
  "assets": { "directory": "node_modules/dovre/assets", "binding": "ASSETS", "run_worker_first": true }
}
